# =========================================================================
# LeadQualify AI - Backend Environment Configuration
# =========================================================================

# Database: SQLite for zero-config local dev, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./leadqualify.db
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OpenRouter AI API (Free 120B NVIDIA Nemotron model configured)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security & Sessions
SECRET_KEY=leadqualify-production-secret-replace-with-random-32-chars

# Crawler Tuning
CRAWLER_MAX_PAGES_PER_DOMAIN=8
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_CONCURRENCY=4
