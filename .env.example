# =========================================================================
# LeadQualify AI - Environment Configuration
# =========================================================================

# Database: SQLite for zero-config local dev, or Supabase PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./leadqualify.db
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OpenRouter AI API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security & Sessions
SECRET_KEY=leadqualify-production-secret-replace-with-random-32-chars

# Supabase (Optional for cloud authentication & storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Crawler Tuning
CRAWLER_MAX_PAGES_PER_DOMAIN=8
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_CONCURRENCY=4
